# Every variable from Section 17.2. No real values in the repo — set secrets in the
# host dashboard. There are deliberately no AI, payment, or database variables in the MVP.

# Canonical base URL (https://heartfixed.com in production)
NEXT_PUBLIC_SITE_URL=

# GA4 property, e.g. G-XXXXXXXXXX. Events reach GA4 through our own /api/collect/ via the
# Measurement Protocol, so no Google script loads in the browser (Section 16.3 budget).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Server-only Measurement Protocol API secret (GA4 → Admin → Data streams → Measurement
# Protocol API secrets). Without it, /api/collect/ validates and then drops events.
GA4_API_SECRET=

# Analytics events per IP per hour accepted by /api/collect/ (default 600)
ANALYTICS_RATE_LIMIT=600

# Server-only key for the email provider (Resend by default)
EMAIL_PROVIDER_API_KEY=

# Verified sender address (founder configures SPF/DKIM/DMARC)
EMAIL_FROM_ADDRESS=

# List/audience id for opt-in subscriptions. In Resend: the Topic id for the email list
# (create it with default subscription "Opt-out", so only people who join receive it).
EMAIL_LIST_ID=

# Resend Topic id for tracker reminders — a separate consent from the list (Section
# 13.1 c), so each can be unsubscribed independently. Also create these contact
# properties in Resend: hf_start_date (string), hf_goal_days (number),
# hf_reminder_hour (number), hf_time_zone (string).
EMAIL_REMINDER_TOPIC_ID=

# Testing only: "memory" records email actions instead of sending them. Never set this
# in production.
EMAIL_PROVIDER=

# Requests per IP per hour for the email endpoint
EMAIL_RATE_LIMIT=5
